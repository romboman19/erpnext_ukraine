{
 "doctype": "DocType",
 "name": "File Delivery Endpoint",
 "module": "Ecommerce",
 "autoname": "field:endpoint_name",
 "title_field": "endpoint_name",
 "search_fields": "endpoint_name,protocol,host,base_path",
 "field_order": ["endpoint_name", "protocol", "host", "port", "credentials_section", "username", "password", "ssh_key", "path_section", "base_path", "passive_mode"],
 "fields": [
  {"fieldname": "endpoint_name", "fieldtype": "Data", "label": "Endpoint Name", "reqd": 1, "unique": 1, "in_list_view": 1},
  {"fieldname": "protocol", "fieldtype": "Select", "label": "Protocol", "options": "FTP\nFTPS\nSFTP", "reqd": 1, "in_list_view": 1},
  {"fieldname": "host", "fieldtype": "Data", "label": "Host", "reqd": 1, "in_list_view": 1, "description": "Must be explicitly listed in ecommerce_allowed_ftp_hosts."},
  {"fieldname": "port", "fieldtype": "Int", "label": "Port", "reqd": 1, "in_list_view": 1},
  {"fieldname": "credentials_section", "fieldtype": "Section Break", "label": "Credentials"},
  {"fieldname": "username", "fieldtype": "Data", "label": "Username", "reqd": 1},
  {"fieldname": "password", "fieldtype": "Password", "label": "Password"},
  {"fieldname": "ssh_key", "fieldtype": "Password", "label": "SSH Private Key", "depends_on": "eval:doc.protocol=='SFTP'"},
  {"fieldname": "path_section", "fieldtype": "Section Break", "label": "Remote Path"},
  {"fieldname": "base_path", "fieldtype": "Data", "label": "Base Path", "default": "/", "reqd": 1},
  {"fieldname": "passive_mode", "fieldtype": "Check", "label": "Passive Mode", "default": "1", "depends_on": "eval:doc.protocol!='SFTP'"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
 ],
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1
}
