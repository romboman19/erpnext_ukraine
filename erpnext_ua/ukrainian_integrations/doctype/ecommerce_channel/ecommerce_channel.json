{
 "doctype": "DocType",
 "name": "Ecommerce Channel",
 "module": "Ukrainian Integrations",
 "autoname": "field:channel_name",
 "title_field": "channel_name",
 "search_fields": "channel_name,provider,store_url",
 "field_order": [
  "channel_name", "provider", "enabled", "configuration_section", "company", "customer_group", "territory", "currency", "selling_price_list", "export_only_mapped_items",
  "routes_section", "catalog_transport", "stock_transport", "orders_transport", "customers_transport", "order_status_transport",
  "api_section", "api_base_url", "api_login", "api_password", "api_batch_size", "orders_page_size", "orders_max_pages", "orders_overlap_minutes", "initial_sync_days",
  "xml_section", "store_url", "catalog_xml_profile", "order_xml_profile",
  "warehouse_section", "warehouses", "status_section", "status_mappings",
  "state_section", "last_catalog_sync_at", "last_stock_sync_at", "last_orders_sync_at", "last_customers_sync_at", "last_order_status_sync_at"
 ],
 "fields": [
  {"fieldname": "channel_name", "fieldtype": "Data", "label": "Channel Name", "reqd": 1, "unique": 1, "in_list_view": 1},
  {"fieldname": "provider", "fieldtype": "Select", "label": "Provider", "options": "Shop-Express\nocStore", "reqd": 1, "in_list_view": 1},
  {"fieldname": "enabled", "fieldtype": "Check", "label": "Enabled", "default": "0", "in_list_view": 1},
  {"fieldname": "configuration_section", "fieldtype": "Section Break", "label": "ERPNext Configuration"},
  {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "reqd": 1},
  {"fieldname": "customer_group", "fieldtype": "Link", "label": "Customer Group", "options": "Customer Group", "reqd": 1},
  {"fieldname": "territory", "fieldtype": "Link", "label": "Territory", "options": "Territory", "reqd": 1},
  {"fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency", "default": "UAH", "reqd": 1},
  {"fieldname": "selling_price_list", "fieldtype": "Link", "label": "Selling Price List", "options": "Price List", "reqd": 1},
  {"fieldname": "export_only_mapped_items", "fieldtype": "Check", "label": "Export Only Mapped Items", "default": "1", "description": "Recommended for production. Only enabled Ecommerce Item Mapping rows are exported."},
  {"fieldname": "routes_section", "fieldtype": "Section Break", "label": "Synchronization Routes"},
  {"fieldname": "catalog_transport", "fieldtype": "Select", "label": "Catalog Transport", "options": "Disabled\nAPI\nXML", "default": "XML", "reqd": 1},
  {"fieldname": "stock_transport", "fieldtype": "Select", "label": "Prices and Stock Transport", "options": "Disabled\nAPI\nXML", "default": "API", "reqd": 1},
  {"fieldname": "orders_transport", "fieldtype": "Select", "label": "Orders Transport", "options": "Disabled\nAPI\nXML", "default": "API", "reqd": 1},
  {"fieldname": "customers_transport", "fieldtype": "Select", "label": "Customers Transport", "options": "Disabled\nAPI\nXML", "default": "API", "reqd": 1},
  {"fieldname": "order_status_transport", "fieldtype": "Select", "label": "Order Status Transport", "options": "Disabled\nAPI\nXML", "default": "Disabled", "reqd": 1},
  {"fieldname": "api_section", "fieldtype": "Section Break", "label": "API", "depends_on": "eval:doc.catalog_transport=='API' || doc.stock_transport=='API' || doc.orders_transport=='API' || doc.customers_transport=='API' || doc.order_status_transport=='API'"},
  {"fieldname": "api_base_url", "fieldtype": "Data", "label": "API Base URL", "description": "Shop domain, for example https://shop.example.ua"},
  {"fieldname": "api_login", "fieldtype": "Data", "label": "API Login"},
  {"fieldname": "api_password", "fieldtype": "Password", "label": "API Password"},
  {"fieldname": "api_batch_size", "fieldtype": "Int", "label": "API Batch Size", "default": "200"},
  {"fieldname": "orders_page_size", "fieldtype": "Int", "label": "Orders Page Size", "default": "100"},
  {"fieldname": "orders_max_pages", "fieldtype": "Int", "label": "Orders Maximum Pages", "default": "50"},
  {"fieldname": "orders_overlap_minutes", "fieldtype": "Int", "label": "Orders Overlap (minutes)", "default": "15"},
  {"fieldname": "initial_sync_days", "fieldtype": "Int", "label": "Initial Sync Days", "default": "7", "description": "How far back the first order and customer API synchronization reads."},
  {"fieldname": "xml_section", "fieldtype": "Section Break", "label": "File Exchange"},
  {"fieldname": "store_url", "fieldtype": "Data", "label": "Store URL", "description": "Public storefront URL used in product feeds"},
  {"fieldname": "catalog_xml_profile", "fieldtype": "Select", "label": "Catalog XML Profile", "options": "Shop-Express YML\nERPNext Exchange XML v1", "default": "Shop-Express YML"},
  {"fieldname": "order_xml_profile", "fieldtype": "Select", "label": "Order XML Profile", "options": "ERPNext Exchange XML v1", "default": "ERPNext Exchange XML v1"},
  {"fieldname": "warehouse_section", "fieldtype": "Section Break", "label": "Warehouses"},
  {"fieldname": "warehouses", "fieldtype": "Table", "label": "Warehouse Mapping", "options": "Ecommerce Warehouse Mapping", "reqd": 1},
  {"fieldname": "status_section", "fieldtype": "Section Break", "label": "Order Status Mapping"},
  {"fieldname": "status_mappings", "fieldtype": "Table", "label": "Status Mapping", "options": "Ecommerce Status Mapping"},
  {"fieldname": "state_section", "fieldtype": "Section Break", "label": "Synchronization State", "collapsible": 1},
  {"fieldname": "last_catalog_sync_at", "fieldtype": "Datetime", "label": "Last Catalog Sync", "read_only": 1},
  {"fieldname": "last_stock_sync_at", "fieldtype": "Datetime", "label": "Last Stock Sync", "read_only": 1},
  {"fieldname": "last_orders_sync_at", "fieldtype": "Datetime", "label": "Last Orders Sync", "read_only": 1},
  {"fieldname": "last_customers_sync_at", "fieldtype": "Datetime", "label": "Last Customers Sync", "read_only": 1},
  {"fieldname": "last_order_status_sync_at", "fieldtype": "Datetime", "label": "Last Order Status Sync", "read_only": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "Sales Manager", "read": 1, "write": 1, "create": 1}
 ],
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1
}
