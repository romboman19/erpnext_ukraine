{
 "doctype": "DocType",
 "name": "Customer Identification Settings",
 "module": "Ukrainian Integrations",
 "issingle": 1,
 "field_order": [
  "enabled", "channel_routing_section", "default_channel", "pos_channel", "allow_pos_channel_selection",
  "ttl_minutes", "max_attempts", "rate_limit_per_10_min", "test_mode", "test_code",
  "sms_section", "sms_enabled", "sms_sender", "sms_template",
  "telegram_section", "telegram_enabled", "telegram_bot_profile", "telegram_webhook_secret",
  "telegram_pos_section", "telegram_ttl_minutes", "telegram_confirm_template", "telegram_confirm_button",
  "telegram_cancel_button", "telegram_welcome_template", "telegram_linked_template",
  "telegram_unmatched_template", "telegram_consent_template",
  "call_section", "call_enabled", "call_verification_number"
 ],
 "fields": [
  {"fieldname": "enabled", "fieldtype": "Check", "label": "Увімкнено", "default": "0"},
  {"fieldname": "channel_routing_section", "fieldtype": "Section Break", "label": "Вибір каналів ідентифікації"},
  {"fieldname": "default_channel", "fieldtype": "Select", "label": "Типовий канал", "options": "SMS\nTelegram\nCall", "default": "SMS", "reqd": 1, "description": "Канал для Desk та інших процесів. SMS надсилається через TurboSMS."},
  {"fieldname": "pos_channel", "fieldtype": "Select", "label": "Канал каси POS", "options": "SMS\nTelegram\nCall", "default": "SMS", "reqd": 1, "description": "Канал, який каса використовує за замовчуванням. Для production встановлено SMS · TurboSMS."},
  {"fieldname": "allow_pos_channel_selection", "fieldtype": "Check", "label": "Дозволити касиру змінювати канал", "default": "0", "description": "Якщо вимкнено, каса завжди використовує налаштований канал POS і не показує касиру перемикач."},
  {"fieldname": "ttl_minutes", "fieldtype": "Int", "label": "Строк дії запиту (хв)", "default": "5", "reqd": 1},
  {"fieldname": "max_attempts", "fieldtype": "Int", "label": "Максимум спроб коду", "default": "5", "reqd": 1},
  {"fieldname": "rate_limit_per_10_min", "fieldtype": "Int", "label": "Запитів на номер за 10 хв", "default": "5", "reqd": 1},
  {"fieldname": "test_mode", "fieldtype": "Check", "label": "Тестовий режим", "default": "0", "description": "SMS не надсилається; код повертається лише System Manager."},
  {"fieldname": "test_code", "fieldtype": "Data", "label": "Довідка", "hidden": 1},
  {"fieldname": "sms_section", "fieldtype": "Section Break", "label": "SMS · TurboSMS"},
  {"fieldname": "sms_enabled", "fieldtype": "Check", "label": "Дозволити SMS", "default": "1"},
  {"fieldname": "sms_sender", "fieldtype": "Select", "label": "Відправник SMS", "description": "Активні відправники з TurboSMS Settings. Якщо не вибрано, використовується локальний відправник за замовчуванням."},
  {"fieldname": "sms_template", "fieldtype": "Small Text", "label": "Шаблон SMS", "default": "Код підтвердження: {code}. Дійсний {minutes} хв."},
  {"fieldname": "telegram_section", "fieldtype": "Section Break", "label": "Telegram-бот", "depends_on": "eval:doc.enabled", "collapsible": 1},
  {"fieldname": "telegram_enabled", "fieldtype": "Check", "label": "Дозволити Telegram", "default": "0"},
  {"fieldname": "telegram_bot_profile", "fieldtype": "Link", "label": "Профіль Telegram-бота", "options": "Telegram Bot Profile", "depends_on": "eval:doc.telegram_enabled", "mandatory_depends_on": "eval:doc.telegram_enabled"},
  {"fieldname": "telegram_webhook_secret", "fieldtype": "Password", "label": "Секрет webhook", "depends_on": "eval:doc.telegram_enabled", "mandatory_depends_on": "eval:doc.telegram_enabled"},
  {"fieldname": "telegram_pos_section", "fieldtype": "Section Break", "label": "Telegram POS push-підтвердження"},
  {"fieldname": "telegram_ttl_minutes", "fieldtype": "Int", "label": "Хвилин на push-підтвердження", "default": "3", "reqd": 1, "description": "Має бути від 1 до 15 хвилин."},
  {"fieldname": "telegram_confirm_template", "fieldtype": "Small Text", "label": "Шаблон push-підтвердження", "default": "Підтвердьте покупку за номером {phone} на касі."},
  {"fieldname": "telegram_confirm_button", "fieldtype": "Data", "label": "Текст кнопки підтвердження", "default": "✅ Підтвердити"},
  {"fieldname": "telegram_cancel_button", "fieldtype": "Data", "label": "Текст кнопки скасування", "default": "❌ Скасувати"},
  {"fieldname": "telegram_welcome_template", "fieldtype": "Small Text", "label": "Шаблон вітання /start", "default": "Вітаємо у боті підтвердження покупця."},
  {"fieldname": "telegram_linked_template", "fieldtype": "Small Text", "label": "Шаблон успішного підключення", "default": "Номер {phone} підключено. Тепер на касі можна підтверджувати покупки одним натисканням."},
  {"fieldname": "telegram_unmatched_template", "fieldtype": "Small Text", "label": "Шаблон невідомого номера", "default": "Ми не знайшли покупця з номером {phone}. Зверніться до касира або зареєструйтесь у магазині."},
  {"fieldname": "telegram_consent_template", "fieldtype": "Small Text", "label": "Шаблон згоди на обробку контакту", "default": "Надсилаючи контакт, ви погоджуєтесь отримувати повідомлення для підтвердження покупок."},
  {"fieldname": "call_section", "fieldtype": "Section Break", "label": "Контрольний дзвінок · VitalPBX"},
  {"fieldname": "call_enabled", "fieldtype": "Check", "label": "Дозволити дзвінок", "default": "0"},
  {"fieldname": "call_verification_number", "fieldtype": "Data", "label": "Номер для контрольного дзвінка"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
 ],
 "engine": "InnoDB"
}
