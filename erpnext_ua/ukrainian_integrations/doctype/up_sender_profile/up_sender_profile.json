{
  "doctype": "DocType",
  "name": "UP Sender Profile",
  "module": "Ukrainian Integrations",
  "autoname": "field:profile_name",
  "title_field": "profile_name",
  "engine": "InnoDB",
  "fields": [
    {"fieldname": "profile_name", "fieldtype": "Data", "label": "Profile Name", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "reqd": 1, "in_list_view": 1},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1", "in_list_view": 1},
    {"fieldname": "is_default", "fieldtype": "Check", "label": "Default", "default": "0", "in_list_view": 1},
    {"fieldname": "sender_name", "fieldtype": "Data", "label": "Sender Name", "reqd": 1},
    {"fieldname": "sender_phone", "fieldtype": "Data", "label": "Sender Phone", "reqd": 1},
    {"fieldname": "sender_email", "fieldtype": "Data", "label": "Sender Email", "options": "Email"},
    {"fieldname": "postcode", "fieldtype": "Data", "label": "Postcode", "reqd": 1},
    {"fieldname": "region", "fieldtype": "Data", "label": "Region", "reqd": 1},
    {"fieldname": "city", "fieldtype": "Data", "label": "City", "reqd": 1},
    {"fieldname": "street", "fieldtype": "Data", "label": "Street", "reqd": 1},
    {"fieldname": "house_number", "fieldtype": "Data", "label": "House Number", "reqd": 1},
    {"fieldname": "apartment_number", "fieldtype": "Data", "label": "Apartment"},
    {"fieldname": "api_base", "fieldtype": "Data", "label": "API Base", "default": "https://www.ukrposhta.ua/ecom/0.0.1"},
    {"fieldname": "ecom_token", "fieldtype": "Password", "label": "eCom Token", "reqd": 1},
    {"fieldname": "tracking_token", "fieldtype": "Password", "label": "Tracking Token"},
    {"fieldname": "counterparty_token", "fieldtype": "Password", "label": "Counterparty Token"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Sales Manager", "read": 1, "write": 1, "create": 1}
  ]
}
