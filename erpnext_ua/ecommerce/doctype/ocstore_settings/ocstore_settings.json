{
 "doctype": "DocType",
 "name": "OcStore Settings",
 "module": "Ecommerce",
 "autoname": "field:store_name",
 "title_field": "store_name",
 "search_fields": "store_name,company,store_url",
 "field_order": [
  "store_name", "enabled", "company", "store_url",
  "erp_section", "currency", "selling_price_list", "fulfillment_physical_location", "default_customer_group", "default_territory", "export_all_items",
  "transport_section", "ftp_profile", "photo_ftp_profile", "photo_url_prefix", "export_file_prefix", "orders_file_prefix", "max_order_files_per_run",
  "sync_section", "sync_entities",
  "warehouses_section", "warehouses",
  "payments_section", "payment_routes",
  "statuses_section", "order_status_map",
  "state_section", "last_export_at", "last_order_import_at", "last_error", "migration_source"
 ],
 "fields": [
  {"fieldname": "store_name", "fieldtype": "Data", "label": "Store Name", "reqd": 1, "unique": 1, "in_list_view": 1},
  {"fieldname": "enabled", "fieldtype": "Check", "label": "Enabled", "default": "0", "in_list_view": 1},
  {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "reqd": 1, "in_list_view": 1},
  {"fieldname": "store_url", "fieldtype": "Data", "label": "Store URL", "description": "Public HTTPS URL of this ocStore instance."},
  {"fieldname": "erp_section", "fieldtype": "Section Break", "label": "ERPNext Configuration"},
  {"fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency", "default": "UAH", "reqd": 1},
  {"fieldname": "selling_price_list", "fieldtype": "Link", "label": "Selling Price List", "options": "Price List", "reqd": 1},
  {"fieldname": "fulfillment_physical_location", "fieldtype": "Link", "label": "Global FIFO Physical Location", "options": "GSF Physical Location", "description": "Routes imported orders through global FIFO and creates one invoice/payment per seller Company."},
  {"fieldname": "default_customer_group", "fieldtype": "Link", "label": "Default Customer Group", "options": "Customer Group", "reqd": 1},
  {"fieldname": "default_territory", "fieldtype": "Link", "label": "Default Territory", "options": "Territory", "reqd": 1},
  {"fieldname": "export_all_items", "fieldtype": "Check", "label": "Export All Enabled Items", "default": "1", "description": "Automatically creates missing mappings using the ERPNext Item Code. Disable to export mapped items only."},
  {"fieldname": "transport_section", "fieldtype": "Section Break", "label": "XML / FTP"},
  {"fieldname": "ftp_profile", "fieldtype": "Link", "label": "Exchange FTP Profile", "options": "File Delivery Endpoint"},
  {"fieldname": "photo_ftp_profile", "fieldtype": "Link", "label": "Photo FTP Profile", "options": "File Delivery Endpoint"},
  {"fieldname": "photo_url_prefix", "fieldtype": "Data", "label": "Photo URL Prefix", "description": "Public HTTPS prefix corresponding to Photo FTP Profile."},
  {"fieldname": "export_file_prefix", "fieldtype": "Data", "label": "Export File Prefix", "default": "ocstore", "reqd": 1, "description": "Produces files such as ocstore-products.xml and ocstore-stock.xml."},
  {"fieldname": "orders_file_prefix", "fieldtype": "Data", "label": "Orders File Prefix", "default": "orders-", "reqd": 1, "description": "Only XML files beginning with this prefix are imported."},
  {"fieldname": "max_order_files_per_run", "fieldtype": "Int", "label": "Maximum Order Files Per Run", "default": "20", "reqd": 1},
  {"fieldname": "sync_section", "fieldtype": "Section Break", "label": "Synchronization Matrix"},
  {"fieldname": "sync_entities", "fieldtype": "Table", "label": "Synchronization Entities", "options": "Ecommerce Sync Entity Config", "reqd": 1},
  {"fieldname": "warehouses_section", "fieldtype": "Section Break", "label": "Warehouses"},
  {"fieldname": "warehouses", "fieldtype": "Table", "label": "Warehouses", "options": "Ecommerce Warehouse Sync"},
  {"fieldname": "payments_section", "fieldtype": "Section Break", "label": "Payment Routing"},
  {"fieldname": "payment_routes", "fieldtype": "Table", "label": "Payment Routes", "options": "Ecommerce Payment Route"},
  {"fieldname": "statuses_section", "fieldtype": "Section Break", "label": "Order Status Mapping"},
  {"fieldname": "order_status_map", "fieldtype": "Table", "label": "Order Status Map", "options": "Ecommerce Order Status Map"},
  {"fieldname": "state_section", "fieldtype": "Section Break", "label": "Synchronization State", "collapsible": 1},
  {"fieldname": "last_export_at", "fieldtype": "Datetime", "label": "Last Export", "read_only": 1},
  {"fieldname": "last_order_import_at", "fieldtype": "Datetime", "label": "Last Order Import", "read_only": 1},
  {"fieldname": "last_error", "fieldtype": "Small Text", "label": "Last Error", "read_only": 1},
  {"fieldname": "migration_source", "fieldtype": "Data", "label": "Migration Source", "read_only": 1, "hidden": 1, "no_copy": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "Sales Manager", "read": 1, "write": 1, "create": 1}
 ],
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1
}
