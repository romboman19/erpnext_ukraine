{
  "doctype": "DocType",
  "name": "Telegram Bot Profile",
  "module": "Ukrainian Integrations",
  "autoname": "field:profile_name",
  "engine": "InnoDB",
  "field_order": [
    "profile_name",
    "enabled",
    "bot_username",
    "bot_token",
    "max_message_length"
  ],
  "fields": [
    {
      "fieldname": "profile_name",
      "fieldtype": "Data",
      "label": "Profile Name",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "bot_username",
      "fieldtype": "Data",
      "label": "Bot Username",
      "description": "Without the leading @ character."
    },
    {
      "fieldname": "bot_token",
      "fieldtype": "Password",
      "label": "Bot Token",
      "permlevel": 1,
      "no_copy": 1
    },
    {
      "fieldname": "max_message_length",
      "fieldtype": "Int",
      "label": "Maximum Message Length",
      "default": "4096",
      "reqd": 1,
      "description": "Telegram allows up to 4096 characters for a text message; PDF captions are limited to 1024."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "System Manager",
      "permlevel": 1,
      "read": 1,
      "write": 1
    },
    {
      "role": "Sales Manager",
      "read": 1
    },
    {
      "role": "Sales User",
      "read": 1
    }
  ]
}
